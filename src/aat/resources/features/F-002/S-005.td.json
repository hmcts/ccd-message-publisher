{
  "_guid_": "S-005",
  "title": "publish the event for a newly created case with its routing properties and field data",
  "productName": "CCD Data Store",
  "operationName": "Create case",
  "method": "POST",
  "uri": "{{PUBLISHING_E2E_DATA_STORE_URL}}/caseworkers/{uid}/jurisdictions/{jid}/case-types/{ctid}/cases",
  "specs": ["with access to the publishing case type"],
  "prerequisites": ["Publishing_CreateCase_Token"],
  "users": {
    "invokingUser": {
      "username": "[[$PUBLISHING_E2E_USERNAME]]",
      "password": "[[$PUBLISHING_E2E_PASSWORD]]"
    }
  },
  "request": {
    "headers": {
      "Authorization": "[[DEFAULT_AUTO_VALUE]]",
      "ServiceAuthorization": "[[DEFAULT_AUTO_VALUE]]",
      "Content-Type": "application/json",
      "Accept": "application/json"
    },
    "pathVariables": {"uid": "[[DEFAULT_AUTO_VALUE]]", "jid": "BEFTA_MASTER", "ctid": "FT_MultiplePages"},
    "body": {
      "event_token": "${[scenarioContext][childContexts][Publishing_CreateCase_Token][testData][actualResponse][body][token]}",
      "event": {"id": "createCase", "summary": "${[scenarioContext][customValues][publishing_marker]}"},
      "data": {"TextFieldLName": "${[scenarioContext][customValues][publishing_marker]}"}
    }
  },
  "expectedResponse": {"responseCode": 201, "responseMessage": "Created"}
}
